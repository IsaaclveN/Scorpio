<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 32px 16px;
      font-family: "Segoe UI", Arial, Helvetica, sans-serif;
      background: #f4f6f8;
      color: #24303f;
    }
    .wrap { max-width: 960px; margin: 0 auto; }
    h1 { margin: 0 0 4px; font-size: 26px; }
    .subtitle { margin: 0 0 24px; color: #6b7a8d; font-size: 14px; }

    .card {
      background: #ffffff;
      border: 1px solid #dde3ea;
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 28px;
      box-shadow: 0 1px 3px rgba(20, 35, 60, 0.06);
    }
    .card h2 { margin: 0 0 16px; font-size: 18px; }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .field { display: flex; flex-direction: column; }
    .field label {
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: #45566b;
    }
    .field input {
      padding: 9px 11px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 14px;
      font-family: inherit;
      background: #fff;
    }
    .field input:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .actions-row { margin-top: 18px; }
    button {
      padding: 10px 22px;
      border: none;
      border-radius: 6px;
      background: #2563eb;
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
    }
    button:hover { background: #1d4ed8; }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border: 1px solid #dde3ea;
      border-radius: 10px;
      overflow: hidden;
      font-size: 14px;
    }
    thead th {
      background: #24303f;
      color: #fff;
      text-align: left;
      padding: 12px 14px;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    tbody td {
      padding: 11px 14px;
      border-top: 1px solid #e8edf3;
      vertical-align: middle;
    }
    tbody tr:nth-child(even) { background: #fafbfd; }
    tbody tr:hover { background: #f0f5ff; }

    .col-id { width: 56px; }
    .col-actions { width: 150px; white-space: nowrap; }
    .empty { text-align: center; color: #8b98a8; padding: 26px; }

    a.edit, a.delete {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 5px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
    }
    a.edit { background: #e0ebff; color: #1d4ed8; }
    a.edit:hover { background: #cfdeff; }
    a.delete { background: #fde2e2; color: #c02626; margin-left: 6px; }
    a.delete:hover { background: #fbd0d0; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>Scopio Records</h1>
    <p class="subtitle">XianFire CRUD &mdash; insert a student record below.</p>

    <!-- ACT 3: insert form -->
    <form class="card" method="POST" action="/scopio">
      <h2>Add a new record</h2>
      <div class="grid">
        <div class="field">
          <label for="FirstName">First Name</label>
          <input type="text" id="FirstName" name="FirstName" required />
        </div>
        <div class="field">
          <label for="MiddleName">Middle Name</label>
          <input type="text" id="MiddleName" name="MiddleName" required />
        </div>
        <div class="field">
          <label for="LastName">Last Name</label>
          <input type="text" id="LastName" name="LastName" required />
        </div>
        <div class="field">
          <label for="Program">Program</label>
          <input type="text" id="Program" name="Program" required />
        </div>
        <div class="field">
          <label for="YearLevel">Year Level</label>
          <input type="text" id="YearLevel" name="YearLevel" required />
        </div>
        <div class="field">
          <label for="Section">Section</label>
          <input type="text" id="Section" name="Section" required />
        </div>
      </div>
      <div class="actions-row">
        <button type="submit">Save Record</button>
      </div>
    </form>

    <!-- ACT 3: list table -->
    <table>
      <thead>
        <tr>
          <th class="col-id">#</th>
          <th>First Name</th>
          <th>Middle Name</th>
          <th>Last Name</th>
          <th>Program</th>
          <th>Year Level</th>
          <th>Section</th>
          <th class="col-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each data}}
          <tr>
            <td>{{this.id}}</td>
            <td>{{this.FirstName}}</td>
            <td>{{this.MiddleName}}</td>
            <td>{{this.LastName}}</td>
            <td>{{this.Program}}</td>
            <td>{{this.YearLevel}}</td>
            <td>{{this.Section}}</td>
            <td class="col-actions">
              <a class="edit" href="/scopio/{{this.id}}/edit">Edit</a>
              <a class="delete" href="/scopio/{{this.id}}/delete"
                 onclick="return confirm('Delete this record?');">Delete</a>
            </td>
          </tr>
        {{else}}
          <tr>
            <td class="empty" colspan="8">No Scopio records yet.</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</body>
</html>
